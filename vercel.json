{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "patient_web": {
      "root": "patient_web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/patient",
      "destination": {
        "service": "patient_web"
      }
    },
    {
      "source": "/patient/(.*)",
      "destination": {
        "service": "patient_web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
