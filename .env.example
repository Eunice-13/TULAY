# TULAY (YAKAP-GAMOT) — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional elevated server-only key. Do NOT prefix with NEXT_PUBLIC_.
# Prefer user-scoped clients plus RLS for ordinary application requests.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notifications (simulated by default) ---
SMS_MODE=simulated
# Actual SMS is optional and must not be claimed unless tested.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
